importC <stdio.h>

func main() -> int {
    para (entero i = 1; i <= 20; i++) {
        si (i % 15 == 0) {
            C.printf("FizzBuzz\n");
        } else if (i % 3 == 0) {
            C.printf("Fizz\n");
        } sino si (i % 5 == 0) {
            C.printf("Buzz\n");
        } else {
            C.printf("%d\n", i);
        }
    }
    return 0;
}